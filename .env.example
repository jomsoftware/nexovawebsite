APP_ENV=local
# Where the SQLite DB, uploads and sessions live. On Railway: /data (a mounted Volume).
DATA_DIR=./data

# Single admin account. Generate the hash with: php bin/hash-password.php "your password"
# In .env wrap the hash in double quotes and escape each $ as \$ . On Railway paste it raw into the variable.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Contact form notifications. null://null = save to DB only, send nothing.
# Example: smtp://user:pass@smtp.example.com:587
MAIL_DSN=null://null
MAIL_FROM=no-reply@example.com
MAIL_TO=sales@example.com
