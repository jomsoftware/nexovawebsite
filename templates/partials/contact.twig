  <section class="contact" id="contact">
    <div class="wrap">
      <div>
        <h2>{{ s.contact_title }}</h2>
        <p class="lede">{{ s.contact_lede }}</p>
        <div class="info">
          <div><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><div><small>Email</small><b>{{ s.contact_email }}</b></div></div>
          <div><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/></svg></span><div><small>Phone</small><b>{{ s.contact_phone }}</b></div></div>
          <div><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span><div><small>Office</small><b>{{ s.contact_office }}</b></div></div>
          <div><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"/></svg></span><div><small>Website</small><b>{{ s.contact_website }}</b></div></div>
        </div>
      </div>
      <form id="contact-form" method="post" action="/contact" novalidate>
        <input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
        <h3>Tell us what is slowing you down</h3>
        <label>Full name<input id="f-name" name="name" required autocomplete="name"></label>
        <label>Company<input id="f-company" name="company" autocomplete="organization"></label>
        <label>Work email<input id="f-email" name="email" type="email" required autocomplete="email"></label>
        <label>Mobile<input id="f-phone" name="phone" type="tel" autocomplete="tel"></label>
        <label class="full">Your industry<select id="f-service" name="service">{% for x in industries %}<option{{ current is defined and current == x.title ? ' selected' }}>{{ x.title }}</option>{% endfor %}<option>Another industry</option></select></label>
        <label class="full">The problem<textarea id="f-msg" name="message" placeholder="What is slowing your team down today, in your own words."></textarea></label>
        <label class="full consent"><input type="checkbox" name="consent" value="1" required><span>I agree that Nexova may use these details to respond to my enquiry, as described in the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span></label>
        <div class="full"><button class="btn btn-primary" type="submit">Send request</button></div>
        <p class="form-msg" id="form-msg" role="status" hidden></p>
      </form>
    </div>
  </section>
