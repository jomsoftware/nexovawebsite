{% extends 'base.twig' %}
{% block main %}
  <section class="phero">
    <img src="/assets/photos/energy-power.jpg" width="1600" height="900" alt="" fetchpriority="high">
    <div class="wrap">
      <h1>{{ (s.hero_title ~ ' ' ~ s.hero_accent)|trim }}.</h1>
      {% if s.hero_scope %}<p class="scope">{{ s.hero_scope }}</p>{% endif %}
      <p class="lede">{{ s.hero_lede }}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contact">Tell us your problem</a>
        <a class="btn btn-outline" href="#industries">Find your industry</a>
      </div>
      <p class="checks"><span>{{ s.hero_check1 }}</span><span>{{ s.hero_check2 }}</span><span>{{ s.hero_check3 }}</span></p>
    </div>
  </section>

  <section id="industries">
    <div class="wrap">
      <div class="head">
        <h2>{{ s.industries_title }}</h2>
        <p>{{ s.industries_lede }}</p>
      </div>
      <ul class="ptiles">
        {% for i in industries %}
        <li class="ptile"><a href="/industries/{{ i.slug }}">
          <img src="/assets/photos/{{ i.slug }}.jpg" width="1600" height="900" alt="" loading="lazy">
          <span class="pt-name">{{ i.title }}</span>
          <span class="pt-text">{{ i.outcome }}</span>
        </a></li>
        {% endfor %}
      </ul>
      <p class="ind-more">Don't see your industry? <a href="#contact">Tell us how your work runs</a> and we will tell you honestly whether we can help.</p>
    </div>
  </section>

  <section id="capabilities" class="caps">
    <div class="wrap">
      <div class="head">
        <h2>{{ s.caps_title }}</h2>
        <p>{{ s.caps_lede }}</p>
      </div>
      <div class="caps-grid">
        <article id="digital-twin">
          <img src="/assets/photos/digital-twin.jpg" width="1600" height="900" alt="Pipes, tanks and walkways of an industrial plant" loading="lazy">
          <h3>{{ s.twin_title }}</h3>
          <p>{{ s.twin_body }}</p>
          <p class="f-outcome">{{ s.twin_outcome }}</p>
        </article>
        <article id="digital-transformation">
          <img src="/assets/photos/digital-transformation.jpg" width="1600" height="900" alt="Two colleagues reviewing a data dashboard on a laptop" loading="lazy">
          <h3>{{ s.dt_title }}</h3>
          <p>{{ s.dt_body }}</p>
          <p class="f-outcome">{{ s.dt_outcome }}</p>
        </article>
      </div>
    </div>
  </section>

  <section id="ai" class="ai">
    <div class="wrap">
      <div class="head">
        <h2>{{ s.ai_title }}</h2>
        <p>{{ s.ai_lede }}</p>
      </div>
      <div class="ai-list">
        {% for a in ai %}
        <article class="ai-row" id="{{ a.slug }}">
          {% if a.image %}<img src="{{ a.image }}" width="800" height="450" alt="Diagram of {{ a.title|lower }}" loading="lazy">{% endif %}
          <div>
            <h3>{{ a.title }}</h3>
            <p>{{ a.body }}</p>
            <p class="f-outcome">{{ a.outcome }}</p>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="process" class="process">
    <div class="wrap">
      <div class="head">
        <h2>{{ s.process_title }}</h2>
        <p>{{ s.process_lede }}</p>
      </div>
      <ol class="steps">
        {% for st in steps %}<li class="step"><span class="step-num">{{ loop.index }}</span><h3>{{ st.title }}</h3><p>{{ st.body }}</p><p class="out">{{ st.deliverable }}</p></li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section id="about">
    <div class="wrap about">
      <h2>{{ s.about_title }}</h2>
      <p class="about-text">{{ s.about_lede }}</p>
    </div>
  </section>

{% include 'partials/contact.twig' %}
{% endblock %}
