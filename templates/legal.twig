<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ doc.title }} · Nexova</title>
<link rel="icon" href="/assets/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap">
<link rel="stylesheet" href="/assets/site.css">
</head><body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Nexova home"><img class="logo-light" src="/assets/logo.png" alt="Nexova"></a>
    <a class="btn btn-outline" href="/">Back to site</a>
  </div>
</header>
<main class="legal">
  <div class="wrap">
    <span class="kicker">Legal</span>
    <h1>{{ doc.title }}</h1>
    <p class="legal-meta">Last updated: {{ updated }}</p>
    {% include 'legal/' ~ page ~ '.twig' %}
    <nav class="legal-nav" aria-label="Legal pages">
      <a href="/privacy">Privacy Policy</a><a href="/cookies">Cookie Policy</a><a href="/terms">Terms of Use</a>
    </nav>
  </div>
</main>
<footer><div class="wrap"><div class="fbottom" style="margin-top:0;border-top:0;padding-top:0"><span>{{ s.footer_copyright }}</span><span>{{ s.contact_email }}</span></div></div></footer>
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-labelledby="cb-title" aria-live="polite" hidden>
  <div>
    <b id="cb-title">Cookies on this site</b>
    <p>We only use essential cookies that keep the site and contact form secure. No tracking or advertising. <a href="/cookies">Cookie Policy</a> · <a href="/privacy">Privacy Policy</a></p>
  </div>
  <button type="button" class="btn btn-primary" data-cookie-ok>Got it</button>
</div>
<script src="/assets/cookie-notice.js"></script>
</body></html>
